# ── HomeWorx 360 Estimator — Environment Variables ─────────────────────────
# Copy this file to .env.local and fill in your keys.

# ── OpenAI (recommended: enables Whisper voice transcription + GPT-4o estimates)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# ── Anthropic Claude (fallback if OPENAI_API_KEY is not set)
# Get your key at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Priority: OPENAI_API_KEY is used first (GPT-4o + Whisper).
# If only ANTHROPIC_API_KEY is set, Claude is used for estimates (no Whisper).
# If neither is set, demo estimates are shown.
