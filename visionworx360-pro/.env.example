# =============================================================================
# VisionWorx360 Pro — environment template
#
#   cp .env.example .env.local        # then fill in DEVELOPMENT values
#
# Placeholders only. Never commit real values: .env, .env.local and .env.*
# are git-ignored (only this file is tracked).
#
# FAIL-CLOSED: there is no built-in backend. `bun dev` refuses to start without
# VITE_SUPABASE_URL + VITE_SUPABASE_PUBLISHABLE_KEY, the app shows a
# configuration error page when they are absent at runtime, and the legacy
# Lovable production Supabase project is refused unless VITE_APP_ENV=production
# (and always refused in tests).
# =============================================================================

# -----------------------------------------------------------------------------
# CORE APPLICATION (required)
# -----------------------------------------------------------------------------
# development | staging | production | test. Unset means development.
# Only an explicit "production" may use a production backend.
VITE_APP_ENV=development
# Shown in the UI / diagnostics. Optional; defaults to 0.1.0.
VITE_APP_VERSION=0.1.0

# -----------------------------------------------------------------------------
# SUPABASE (required)
# Use a DEVELOPMENT project (or a local `supabase start` stack), never production.
# -----------------------------------------------------------------------------
# Browser + SSR public config (inlined at build time when present).
VITE_SUPABASE_URL=https://your-dev-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_dev_key
# Server functions and auth middleware read these (same values as above).
SUPABASE_URL=https://your-dev-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_dev_key
# SERVER ONLY — bypasses RLS. Needed by admin server functions, the Stripe
# webhook, proposal sharing and material pricing. Never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# AI (required for AI features: narration estimates, assembly expansion,
# material estimates, photo/vision understanding, measurement capture,
# dictation fallback / transcription)
# LEGACY LOVABLE-SPECIFIC: these calls go to the Lovable AI Gateway
# (ai.gateway.lovable.dev). Replacement with a direct provider is a later
# phase. Without a key the AI features fail; the rest of the app works.
# -----------------------------------------------------------------------------
LOVABLE_API_KEY=

# -----------------------------------------------------------------------------
# STRIPE / PAYMENTS (required only for billing)
# Without STRIPE_WEBHOOK_SECRET the webhook answers 503 billing_not_configured.
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_CONTRACTOR=
STRIPE_TRIAL_DAYS=

# -----------------------------------------------------------------------------
# OPTIONAL
# -----------------------------------------------------------------------------
# Build metadata, normally injected by CI.
VITE_BUILD_TIMESTAMP=
# Overrides the computed public-config fingerprint shown in diagnostics.
VITE_PUBLIC_ENV_FINGERPRINT=
# MCP server (src/lib/mcp): Supabase project ref used as the OAuth issuer.
# Only needed if the MCP endpoints are kept (see docs/LOVABLE_DEPENDENCIES.md).
VITE_SUPABASE_PROJECT_ID=
# Alternative key names the MCP helper also accepts (legacy Supabase naming):
# SUPABASE_ANON_KEY= / VITE_SUPABASE_ANON_KEY= / SUPABASE_PUBLISHABLE_KEYS={"default":"sb_publishable_..."}

# -----------------------------------------------------------------------------
# INTEGRATION TESTS (set automatically by `bun run test:integration`)
# Must point at a throwaway LOCAL database; remote targets are refused.
# -----------------------------------------------------------------------------
# VW_IT_POSTGREST_URL=http://127.0.0.1:54330
# VW_IT_PG_URL=postgres://supabase_admin:postgres@127.0.0.1:54329/postgres
# VW_IT_JWT_SECRET=local-only-jwt-secret-at-least-32-characters
# VW_IT_EVIDENCE_OUT=            # optional: write pricing evidence JSON here
# VW_IT_ALLOW_NONLOCAL_DB=       # 1 = allow a non-loopback TEST database (never production)

# -----------------------------------------------------------------------------
# FUTURE DEPLOYMENT CONFIGURATION (not read by the code yet)
# The production build is a Cloudflare Worker (nitro preset). A deployment
# supplies the variables above as Worker secrets/vars with VITE_APP_ENV=production.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# -----------------------------------------------------------------------------
